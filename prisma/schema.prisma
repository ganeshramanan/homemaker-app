generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           Int       @id @default(autoincrement())
  name         String
  phone        String    @unique
  passwordHash String
  role         String    @default("user")    // user | admin
  status       String    @default("pending") // pending | active | disabled
  isDemo       Boolean   @default(false)
  modules      String    @default("provisions,budget,calendar,diary,weight") // sections the ADMIN allows for this user
  hiddenModules String   @default("")  // sections the USER chose to hide
  hiddenCats   String    @default("")  // budget categories the USER removed, as JSON {income:[],expense:[]}
  categoryGroups String   @default("")  // the person's own category to group choices, JSON {"Gold chit":"saving"}
  reminderEmails String   @default("")  // comma-separated addresses that get event reminder emails
  reminderDays   String   @default("7") // comma-separated days before an event: e.g. "7,1,0"
  weightReminderDay Int   @default(0)  // 0 = off, else the day of the month (1-28) to email a "log your weights" reminder
  createdAt    DateTime  @default(now())
  sessions     Session[]
  items        Item[]
  lists        List[]
  budgetEntries BudgetEntry[]
  calendarEvents CalendarEvent[]
  diaryEntries DiaryEntry[]
  diaryPhotos  DiaryPhoto[]
  familyMembers FamilyMember[]
  weightEntries WeightEntry[]
}

model Session {
  id        String   @id
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime

  @@index([userId])
}

model Item {
  id        Int        @id @default(autoincrement())
  userId    Int?
  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  category  String     @default("Other")
  unit      String     @default("pcs")
  stock     Float      @default(0)
  minQty    Float      @default(0)
  listItems ListItem[]

  @@unique([userId, name])
}

model List {
  id        Int        @id @default(autoincrement())
  userId    Int?
  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  status    String     @default("active") // active | done
  createdAt DateTime   @default(now())
  closedAt  DateTime?
  items     ListItem[]

  @@index([userId, status])
}

model ListItem {
  id       Int     @id @default(autoincrement())
  listId   Int
  list     List    @relation(fields: [listId], references: [id], onDelete: Cascade)
  itemId   Int?
  item     Item?   @relation(fields: [itemId], references: [id], onDelete: SetNull)
  name     String
  qty      Float   @default(1)
  unit     String  @default("pcs")
  bought   Boolean @default(false)
  price    Float? // for the future Budget module
  position Int     @default(0)

  @@index([listId])
}

model BudgetEntry {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  month     String   // "2026-10"
  type      String   // income | expense
  category  String   @default("Other")
  title     String
  amount    Float
  paid      Boolean  @default(false) // for expenses: already paid?
  createdAt DateTime @default(now())

  @@index([userId, month])
}

model CalendarEvent {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  date      String   // "2026-10-25": the first (or only) date
  time      String?  // "14:30", or null for an all-day event
  category  String   @default("Other")
  repeat    String   @default("none") // none | yearly | monthly
  note      String   @default("")
  createdAt DateTime @default(now())

  @@index([userId, date])
}

model DiaryEntry {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      String   // "2026-10-20": one entry per person per day
  text      String   @default("")
  mood      String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
}

// A photo attached to a diary day. Stored as JPEG bytes in the database; always read through a signed-in, owner-only route.
model DiaryPhoto {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      String
  data      Bytes
  size      Int
  createdAt DateTime @default(now())

  @@index([userId, date])
}

// One row per reminder already emailed (user + event + the day it happens + how many days ahead), so retries never double-send.
model ReminderSent {
  id        Int      @id @default(autoincrement())
  userId    Int
  eventId   Int
  onDate    String
  daysAhead Int
  sentAt    DateTime @default(now())

  @@unique([userId, eventId, onDate, daysAhead])
}

// A person whose weight is tracked (not a login: just a name in this family).
model FamilyMember {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  birthYear Int?
  heightCm  Float?
  targetKg  Float?
  createdAt DateTime @default(now())
  entries   WeightEntry[]

  @@index([userId])
}

// One weight reading per person per day.
model WeightEntry {
  id       Int          @id @default(autoincrement())
  userId   Int
  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  memberId Int
  member   FamilyMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  date     String
  kg       Float

  @@unique([memberId, date])
  @@index([userId])
}
